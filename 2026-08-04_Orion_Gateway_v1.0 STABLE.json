      "parameters": {
        "jsCode": "const body = $json.body || {};\n\n// Missing query field\nif (typeof body.query === \"undefined\") {\n  return [\n    {\n      json: {\n        response: \"Missing required field: query.\"\n      }\n    }\n  ];\n}\n\n// Empty query\nif (typeof body.query !== \"string\" || body.query.trim() === \"\") {\n  return [\n    {\n      json: {\n        response: \"Please enter a search query.\"\n      }\n    }\n  ];\n}\n\n// Valid query\nreturn [\n  {\n    json: {\n      endpoint: \"search\",\n      query: body.query.trim()\n    }\n  }\n];"
      },
